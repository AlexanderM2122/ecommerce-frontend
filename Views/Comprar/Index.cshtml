@model IEnumerable<EcommerceFrontend.Models.Producto>
@{
    ViewData["Title"] = "Comprar";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <h1 class="h2 mb-0">Catálogo de productos</h1>
    <a asp-controller="Carrito" asp-action="Index" class="btn btn-outline-primary">Ver carrito</a>
</div>

<partial name="_MensajesCompra" />

@if (Model.Any())
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <partial name="_CardPartial" model="item" />
        }
    </div>
}
else
{
    <div class="alert alert-warning">No hay productos disponibles por el momento.</div>
}