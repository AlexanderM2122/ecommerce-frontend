
@model IReadOnlyList<Archivo>

@{
    ViewData["Title"] = "Archivos";
}

<div class="container mt-4">

    <h2 class="mb-4">Listado de archivos</h2>


    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">
            @mensaje
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">
            @error
        </div>
    }


    <a asp-controller="Archivos"
    asp-action="Subir"
    class="btn btn-primary mb-3">
        Subir imagen
    </a>


    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No hay imágenes registradas.
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Imagen</th>
                    <th>Nombre</th>
                    <th>Tipo</th>
                    <th>Tamaño</th>
                    <th>Almacenamiento</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var archivo in Model)
                {
                    <tr>
                        <td>@archivo.ArchivoId</td>

                        <td>
                            <img src="@Url.Action(
                                "Imagen",
                                "Archivos",
                                new { id = archivo.ArchivoId })"
                                 alt="@archivo.Nombre"
                                 loading="lazy"
                                 style="max-width:80px;max-height:80px"
                                 class="img-thumbnail" />
                        </td>

                        <td>@archivo.Nombre</td>

                        <td>@archivo.Mime</td>

                        <td>
                            @((archivo.Size / 1024.0).ToString("N1")) KB
                        </td>

                        <td>
                            @(archivo.InDb
                                ? "Base de datos"
                                : "Sistema de archivos")
                        </td>

                        <td>
                            <a asp-controller="Archivos"
                            asp-action="Detalle"
                            asp-route-id="@archivo.ArchivoId"
                            class="btn btn-info btn-sm">
                                Ver detalle
                            </a>


                            <a asp-controller="Archivos"
                            asp-action="Editar"
                            asp-route-id="@archivo.ArchivoId"
                            class="btn btn-warning btn-sm">
                                Reemplazar
                            </a>

                            <a asp-controller="Archivos"
                            asp-action="Eliminar"
                            asp-route-id="@archivo.ArchivoId"
                            class="btn btn-danger btn-sm">
                                Eliminar
                            </a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>
