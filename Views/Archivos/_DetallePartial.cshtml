
@model Archivo

<div class="card mt-3">
    <div class="card-body">

        <div class="text-center mb-4">
            <img src="@Url.Action(
                "Imagen",
                "Archivos",
                new { id = Model.ArchivoId })"
                 alt="@Model.Nombre"
                 class="img-fluid img-thumbnail"
                 style="max-height:300px" />
        </div>

        <dl class="row">

            <dt class="col-sm-4">ID</dt>
            <dd class="col-sm-8">
                @Model.ArchivoId
            </dd>

            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">
                @Model.Nombre
            </dd>

            <dt class="col-sm-4">Tipo MIME</dt>
            <dd class="col-sm-8">
                @Model.Mime
            </dd>

            <dt class="col-sm-4">Tamaño</dt>
            <dd class="col-sm-8">
                @((Model.Size / 1024.0).ToString("N1")) KB
            </dd>

            <dt class="col-sm-4">Almacenamiento</dt>
            <dd class="col-sm-8">
                @(Model.InDb
                    ? "Base de datos"
                    : "Sistema de archivos")
            </dd>

        </dl>

    </div>
</div>
