@model Pedido
@{
    ViewData["Title"] = $"Pedido #{Model.Id}";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <h1 class="h2 mb-0">@ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-outline-primary">Ver pedidos</a>
</div>

<partial name="_MensajesCompra" />

<dl class="row">
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.Estado</dd>
    <dt class="col-sm-3">Fecha (UTC)</dt>
    <dd class="col-sm-9">@Model.CreatedAt.UtcDateTime.ToString("dd/MM/yyyy HH:mm")</dd>
    @if (User.IsInRole("Administrador") && Model.Usuario is not null)
    {
        <dt class="col-sm-3">Cliente</dt>
        <dd class="col-sm-9">@Model.Usuario.Nombre (@Model.Usuario.Email)</dd>
    }
</dl>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Producto</th>
                <th scope="col" class="text-end">Cantidad</th>
                <th scope="col" class="text-end">Precio unitario</th>
                <th scope="col" class="text-end">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detalle in Model.Detalles)
            {
                <tr>
                    <th scope="row">@(detalle.Producto?.Titulo ?? $"Producto #{detalle.ProductoId}")</th>
                    <td class="text-end">@detalle.Cantidad</td>
                    <td class="text-end text-nowrap">$@detalle.PrecioUnitario.ToString("N2")</td>
                    <td class="text-end text-nowrap">$@((detalle.PrecioUnitario * detalle.Cantidad).ToString("N2"))</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th scope="row" colspan="3" class="text-end">Total</th>
                <td class="text-end fw-bold text-nowrap">$@Model.Total.ToString("N2")</td>
            </tr>
        </tfoot>
    </table>
</div>
