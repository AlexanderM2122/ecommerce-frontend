
@model ProductoCrearForm

@{
    ViewData["Title"] = "Crear producto";
}

<div class="container mt-4">

    <h2 class="mb-4">Crear producto</h2>

    <form asp-controller="Productos"
          asp-action="Crear"
          method="post" enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Titulo" class="form-label">
                Título
            </label>

            <input asp-for="Titulo"
                   class="form-control"
                   maxlength="255"
                   required />

            <span asp-validation-for="Titulo"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">
                Descripción
            </label>

            <textarea asp-for="Descripcion"
                      class="form-control"
                      rows="4"
                      required></textarea>

            <span asp-validation-for="Descripcion"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Precio" class="form-label">
                Precio
            </label>

            <input asp-for="Precio"
                   class="form-control"
                   type="number"
                   min="0.01"
                   max="99999999.99"
                   step="0.01"
                   required />

            <span asp-validation-for="Precio"
                  class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="Imagen" class="form-label">Imagen del producto (opcional)</label>
            <input asp-for="Imagen" type="file" accept=".jpg,image/jpeg" class="form-control" data-validar-imagen
                   aria-describedby="ayuda-imagen" />
            <span asp-validation-for="Imagen" class="text-danger"></span>
            <div id="ayuda-imagen" class="form-text">
                Selecciona un JPG de hasta 5 MB. Se guardará en Archivos al guardar el producto.
            </div>
        </div>
        <details class="mb-3" open="@(ViewData.ModelState[nameof(Model.ArchivoId)]?.Errors.Count > 0)">
            <summary>Opciones de imagen guardada</summary>
                <label asp-for="ArchivoId" class="form-label">
                    Imagen de Archivos
                </label>

                <select asp-for="ArchivoId" class="form-select">
                    <option value="">Sin imagen</option>

                    @foreach (var archivo in Model.ArchivosDisponibles)
                    {
                        <option value="@archivo.ArchivoId">
                            @archivo.Nombre
                        </option>
                    }
                </select>

                <span asp-validation-for="ArchivoId"
                    class="text-danger"></span>

                <div class="form-text">
                    Puedes conservar, retirar o reutilizar una imagen guardada.
                </div>
        </details>


        <fieldset class="mb-4">
            <legend class="form-label fs-6">Categorías</legend>

            @if (Model.CategoriasDisponibles.Count == 0)
            {
                <p class="text-muted">
                    No hay categorías disponibles.
                </p>
            }
            else
            {
                @foreach (var categoria in Model.CategoriasDisponibles)
                {
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="CategoriaIds"
                               id="categoria-@categoria.CategoriaId"
                               value="@categoria.CategoriaId"
                               checked="@(Model.CategoriaIds.Contains(categoria.CategoriaId))" />

                        <label class="form-check-label"
                               for="categoria-@categoria.CategoriaId">
                            @categoria.Nombre
                        </label>
                    </div>
                }
            }
        </fieldset>

        <button type="submit"
                class="btn btn-primary">
            Guardar producto
        </button>

        <a asp-controller="Productos"
           asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>

@section Scripts {
    <script src="~/js/validar-imagen.js"
            asp-append-version="true"></script>
}