
@model ProductoCrearForm

@{
    ViewData["Title"] = "Crear producto";
}

<div class="container mt-4">

    <h2 class="mb-4">Crear producto</h2>

    <form asp-controller="Productos"
          asp-action="Crear"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Titulo" class="form-label">
                Título
            </label>

            <input asp-for="Titulo"
                   class="form-control"
                   maxlength="255"
                   required />

            <span asp-validation-for="Titulo"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">
                Descripción
            </label>

            <textarea asp-for="Descripcion"
                      class="form-control"
                      rows="4"
                      required></textarea>

            <span asp-validation-for="Descripcion"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Precio" class="form-label">
                Precio
            </label>

            <input asp-for="Precio"
                   class="form-control"
                   type="number"
                   min="0.01"
                   max="99999999.99"
                   step="0.01"
                   required />

            <span asp-validation-for="Precio"
                  class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="ArchivoId" class="form-label">
                Imagen del producto (opcional)
            </label>

            <select asp-for="ArchivoId" class="form-select">
                <option value="">Sin imagen</option>

                @foreach (var archivo in Model.ArchivosDisponibles)
                {
                    <option value="@archivo.ArchivoId">
                        @archivo.Nombre
                    </option>
                }
            </select>

            <span asp-validation-for="ArchivoId"
                class="text-danger"></span>

            <div class="form-text">
                Selecciona una imagen registrada en el módulo Archivos.
            </div>
        </div>


        <div class="mb-4">
            <label class="form-label">Categorías</label>

            @if (Model.CategoriasDisponibles.Count == 0)
            {
                <p class="text-muted">
                    No hay categorías disponibles.
                </p>
            }
            else
            {
                @foreach (var categoria in Model.CategoriasDisponibles)
                {
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="CategoriaIds"
                               id="categoria-@categoria.CategoriaId"
                               value="@categoria.CategoriaId"
                               checked="@(Model.CategoriaIds.Contains(categoria.CategoriaId))" />

                        <label class="form-check-label"
                               for="categoria-@categoria.CategoriaId">
                            @categoria.Nombre
                        </label>
                    </div>
                }
            }
        </div>

        <button type="submit"
                class="btn btn-primary">
            Guardar producto
        </button>

        <a asp-controller="Productos"
           asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>
