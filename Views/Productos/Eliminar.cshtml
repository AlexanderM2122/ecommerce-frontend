
@model Producto
@using System.Globalization

@{
    ViewData["Title"] = "Eliminar producto";
}

<div class="container mt-4">

    <h2 class="mb-4">Eliminar producto</h2>

    <div class="alert alert-danger">
        ¿Estás seguro de que deseas eliminar este producto?
        Esta acción no se puede deshacer.
    </div>

    <div class="card mb-4">
        <div class="card-body">

            <h4>@Model.Titulo</h4>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">
                    @Model.ProductoId
                </dd>

                <dt class="col-sm-3">Descripción</dt>
                <dd class="col-sm-9">
                    @Model.Descripcion
                </dd>

                <dt class="col-sm-3">Precio</dt>
                <dd class="col-sm-9">
                    @Model.Precio.ToString(
                        "C",
                        CultureInfo.GetCultureInfo("es-MX"))
                </dd>

                <dt class="col-sm-3">Categorías</dt>
                <dd class="col-sm-9">
                    @if (Model.Categorias.Count > 0)
                    {
                        @string.Join(", ",
                            Model.Categorias.Select(c => c.Nombre))
                    }
                    else
                    {
                        <span>Sin categorías</span>
                    }
                </dd>

            </dl>

        </div>
    </div>

    <form asp-controller="Productos"
          asp-action="EliminarConfirmado"
          asp-route-id="@Model.ProductoId"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="btn btn-danger">
            Confirmar eliminación
        </button>

        <a asp-controller="Productos"
           asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>
