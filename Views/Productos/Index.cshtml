
@model IReadOnlyList<Producto>
@using System.Globalization

@{
    ViewData["Title"] = "Productos";
}

<div class="container mt-4">

    <h2 class="mb-4">Listado de productos</h2>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">
            @mensaje
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">
            @error
        </div>
    }

    @if (User.IsInRole("Administrador"))
    {
        <a asp-controller="Productos"
        asp-action="Crear"
        class="btn btn-primary mb-3">
            Nuevo producto
        </a>
    }


    <form method="get"
          asp-controller="Productos"
          asp-action="Index"
          class="row g-2 mb-4">

        <label for="busquedaProducto" class="visually-hidden">
            Buscar producto por título
        </label>

        <input type="text"
            id="busquedaProducto"
            name="s"
            value="@(ViewData["Busqueda"])"
            class="form-control"
            maxlength="100"
            placeholder="Buscar por título..." />

        <div class="col-md-4">
            <button type="submit"
                    class="btn btn-primary">
                Buscar
            </button>

            <a asp-controller="Productos"
               asp-action="Index"
               class="btn btn-secondary">
                Limpiar
            </a>
        </div>
    </form>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No se encontraron productos.
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Imagen</th>
                    <th>Título</th>
                    <th>Descripción</th>
                    <th>Precio</th>
                    <th>Categorías</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var producto in Model)
                {
                    <tr>
                        <td>@producto.ProductoId</td>


                        <td>
                            @if (producto.ArchivoId.HasValue)
                            {
                                <img src="@Url.Action(
                                    "Imagen",
                                    "Archivos",
                                    new { id = producto.ArchivoId.Value })"
                                    alt="@producto.Titulo"
                                    class="img-thumbnail"
                                    loading="lazy"
                                    style="max-width:80px;max-height:80px" />
                            }
                            else
                            {
                                <span class="text-muted">Sin imagen</span>
                            }
                        </td>


                        <td>@producto.Titulo</td>

                        <td>@producto.Descripcion</td>

                        <td>
                            @producto.Precio.ToString(
                                "C",
                                CultureInfo.GetCultureInfo("es-MX"))
                        </td>

                        <td>
                            @if (producto.Categorias.Count > 0)
                            {
                                @string.Join(", ",
                                    producto.Categorias.Select(c => c.Nombre))
                            }
                            else
                            {
                                <span>Sin categorías</span>
                            }
                        </td>


                        <td>
                            <a asp-controller="Productos"
                            asp-action="Detalle"
                            asp-route-id="@producto.ProductoId"
                            class="btn btn-info btn-sm">
                                Ver detalle
                            </a>

                            @if (User.IsInRole("Administrador"))
                            {
                                <a asp-controller="Productos"
                                asp-action="Editar"
                                asp-route-id="@producto.ProductoId"
                                class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                <a asp-controller="Productos"
                                asp-action="Eliminar"
                                asp-route-id="@producto.ProductoId"
                                class="btn btn-danger btn-sm">
                                    Eliminar
                                </a>
                            }
                        </td>
                        

                    </tr>
                }
            </tbody>
        </table>
    }
</div>
