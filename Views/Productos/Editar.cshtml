
@model ProductoEditarForm

@{
    ViewData["Title"] = "Editar producto";
}

<div class="container mt-4">

    <h2 class="mb-4">Editar producto</h2>

    <form method="post" enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Titulo" class="form-label">
                Título
            </label>

            <input asp-for="Titulo"
                   class="form-control"
                   maxlength="255"
                   required />

            <span asp-validation-for="Titulo"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">
                Descripción
            </label>

            <textarea asp-for="Descripcion"
                      class="form-control"
                      rows="4"
                      required></textarea>

            <span asp-validation-for="Descripcion"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Precio" class="form-label">
                Precio
            </label>

            <input asp-for="Precio"
                   class="form-control"
                   type="number"
                   min="0.01"
                   max="99999999.99"
                   step="0.01"
                   required />

            <span asp-validation-for="Precio"
                  class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="Imagen" class="form-label">Imagen del producto (opcional)</label>
            <input asp-for="Imagen" type="file" accept=".jpg,image/jpeg" class="form-control"
                   aria-describedby="ayuda-imagen" />
            <span asp-validation-for="Imagen" class="text-danger"></span>
            <div id="ayuda-imagen" class="form-text">
                Selecciona un JPG de hasta 5 MB. Se guardará en Archivos al guardar el producto.
            </div>
        </div>
        <details class="mb-3" open="@(ViewData.ModelState[nameof(Model.ArchivoId)]?.Errors.Count > 0)">
            <summary>Opciones de imagen guardada</summary>
                <label asp-for="ArchivoId" class="form-label">
                    Imagen de Archivos
                </label>

                <select asp-for="ArchivoId" class="form-select">
                    <option value="">Sin imagen</option>

                    @foreach (var archivo in Model.ArchivosDisponibles)
                    {
                        <option value="@archivo.ArchivoId">
                            @archivo.Nombre
                        </option>
                    }
                </select>

                <span asp-validation-for="ArchivoId"
                    class="text-danger"></span>

                <div class="form-text">
                    Puedes conservar, retirar o reutilizar una imagen guardada.
                </div>
        </details>


        <button type="submit"
                class="btn btn-primary">
            Guardar cambios
        </button>

        <a asp-controller="Productos"
           asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>
</div>
