
@model Producto

@{
    ViewData["Title"] = "Categorías del producto";
}

<div class="container mt-4">

    <h2>Categorías de @Model.Titulo</h2>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">
            @mensaje
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">
            @error
        </div>
    }

    <a asp-action="CategoriasAgregar"
       asp-route-id="@Model.ProductoId"
       class="btn btn-primary my-3">
        Agregar categoría
    </a>

    @if (Model.Categorias.Count == 0)
    {
        <div class="alert alert-info">
            Este producto no tiene categorías asignadas.
        </div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var categoria in Model.Categorias)
                {
                    <tr>
                        <td>@categoria.CategoriaId</td>
                        <td>@categoria.Nombre</td>
                        <td>
                            <form asp-controller="Productos"
                                  asp-action="CategoriasRemover"
                                  asp-route-id="@Model.ProductoId"
                                  asp-route-categoriaId="@categoria.CategoriaId"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Quitar categoría
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a asp-action="Detalle"
       asp-route-id="@Model.ProductoId"
       class="btn btn-secondary">
        Volver al producto
    </a>
</div>
