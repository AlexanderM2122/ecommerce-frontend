
@model CategoriaForm

@{
    ViewData["Title"] = "Editar categoría";
}

<h2 class="mb-4">Editar categoría</h2>

<form method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Nombre"
               class="form-label">
            Nombre
        </label>

        <input asp-for="Nombre"
               class="form-control"
               maxlength="255"
               required />

        <span asp-validation-for="Nombre"
              class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Guardar cambios
    </button>

    <a asp-controller="Categorias"
       asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>
</form>
