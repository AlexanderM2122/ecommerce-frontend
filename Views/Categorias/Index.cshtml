
@model IReadOnlyList<Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<div class="container mt-4">

    <h2 class="mb-4">Listado de categorías</h2>

    <a asp-controller="Categorias"
       asp-action="Crear"
       class="btn btn-primary mb-3">
        Nueva categoría
    </a>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No hay categorías registradas.
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Protegida</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var categoria in Model)
                {
                    <tr>
                        <td>@categoria.CategoriaId</td>

                        <td>@categoria.Nombre</td>

                        <td>
                            @(categoria.Protegida ? "Sí" : "No")
                        </td>

                        <td>
                            <a asp-action="Detalle"
                               asp-route-id="@categoria.CategoriaId"
                               class="btn btn-outline-primary btn-sm">
                                Ver detalle
                            </a>

                            <a asp-controller="Categorias"
                               asp-action="Editar"
                               asp-route-id="@categoria.CategoriaId"
                               class="btn btn-warning btn-sm">
                                Editar
                            </a>


                            @if (!categoria.Protegida)
                            {
                                <a asp-controller="Categorias"
                                asp-action="Eliminar"
                                asp-route-id="@categoria.CategoriaId"
                                class="btn btn-danger btn-sm">
                                    Eliminar
                                </a>
                            }
                        </td>
                    </tr>
                }

                @if (TempData["Mensaje"] is string mensaje)
                {
                    <div class="alert alert-success">
                        @mensaje
                    </div>
                }

                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger">
                        @error
                    </div>
                }
            </tbody>
        </table>
    }
</div>
