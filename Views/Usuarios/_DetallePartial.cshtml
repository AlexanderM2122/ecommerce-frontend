@model Usuario

<div class="card mt-3">
    <div class="card-body">

        <dl class="mb-0">

            <dt class="form-label fw-bold">
                Correo electrónico
            </dt>
            <dd class="mb-3">
                @Model.Email
            </dd>

            <dt class="form-label fw-bold">
                Nombre
            </dt>
            <dd class="mb-3">
                @Model.Nombre
            </dd>

            <dt class="form-label fw-bold">
                Rol
            </dt>
            <dd class="mb-3">
                @Model.Rol
            </dd>

        </dl>

    </div>
</div>