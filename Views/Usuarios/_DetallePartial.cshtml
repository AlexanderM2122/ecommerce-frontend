
@model Usuario

<div class="card mt-3">
    <div class="card-body">

        <div class="mb-3">
            <label class="form-label fw-bold">
                Correo electrónico
            </label>

            <div>@Model.Email</div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">
                Nombre
            </label>

            <div>@Model.Nombre</div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">
                Rol
            </label>

            <div>@Model.Rol</div>
        </div>

    </div>
</div>
