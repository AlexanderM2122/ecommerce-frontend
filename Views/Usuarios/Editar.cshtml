
@model UsuarioEditarForm

@{
    ViewData["Title"] = "Editar usuario";
    var email = ViewData["Email"] as string ?? "";
}

<div class="container mt-4">

    <h2 class="mb-4">Editar usuario</h2>

    <form asp-controller="Usuarios"
          asp-action="Editar"
          asp-route-email="@email"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label for="correoUsuario" class="form-label">
                Correo electrónico
            </label>

            <input type="email"
                id="correoUsuario"
                value="@email"
                class="form-control"
                disabled />
        </div>

        <div class="mb-3">
            <label asp-for="Nombre"
                   class="form-label">
                Nombre
            </label>

            <input asp-for="Nombre"
                   class="form-control"
                   maxlength="255"
                   required />

            <span asp-validation-for="Nombre"
                  class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Rol"
                   class="form-label">
                Rol
            </label>

            <select asp-for="Rol"
                    class="form-select"
                    required>

                <option value="Usuario">
                    Usuario
                </option>

                <option value="Administrador">
                    Administrador
                </option>

            </select>

            <span asp-validation-for="Rol"
                  class="text-danger"></span>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Guardar cambios
        </button>

        <a asp-controller="Usuarios"
           asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>
