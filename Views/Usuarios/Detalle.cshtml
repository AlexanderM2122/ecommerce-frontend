
@model Usuario

@{
    ViewData["Title"] = "Detalle del usuario";
}

<div class="container mt-4">

    <h2 class="mb-4">Detalle del usuario</h2>


    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">
            @mensaje
        </div>
    }


    <partial name="_DetallePartial" model="Model" />

    <div class="mt-3">
        <a asp-controller="Usuarios"
           asp-action="Index"
           class="btn btn-secondary">
            Volver al listado
        </a>


        <a asp-controller="Usuarios"
        asp-action="Editar"
        asp-route-email="@Model.Email"
        class="btn btn-warning">
            Editar usuario
        </a>

    </div>

</div>
