
@model UsuarioCrearForm

@{
    ViewData["Title"] = "Crear usuario";
}

<div class="container mt-4">

    <h2 class="mb-4">Crear usuario</h2>

    <form asp-controller="Usuarios"
          asp-action="Crear"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Email"
                   class="form-label">
                Correo electrónico
            </label>

            <input asp-for="Email"
                   type="email"
                   class="form-control"
                   maxlength="255"
                   autocomplete="off"
                   required />
        </div>

        <div class="mb-3">
            <label asp-for="Nombre"
                   class="form-label">
                Nombre
            </label>

            <input asp-for="Nombre"
                   class="form-control"
                   maxlength="255"
                   required />
        </div>

        <div class="mb-3">
            <label asp-for="Password"
                   class="form-label">
                Contraseña
            </label>

            <input asp-for="Password"
                   type="password"
                   class="form-control"
                   minlength="8"
                   maxlength="72"
                   autocomplete="new-password"
                   required />

            <span asp-validation-for="Password"
                  class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Rol"
                   class="form-label">
                Rol
            </label>

            <select asp-for="Rol"
                    class="form-select"
                    required>

                <option value="">
                    Selecciona un rol
                </option>

                <option value="Usuario">
                    Usuario
                </option>

                <option value="Administrador">
                    Administrador
                </option>

            </select>

            <span asp-validation-for="Rol"
                  class="text-danger"></span>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Guardar usuario
        </button>

        <a asp-controller="Usuarios"
           asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>
</div>
