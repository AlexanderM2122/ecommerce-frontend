<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>@ViewData["Title"] - Ecommerce</title>
        <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />

        <link rel="stylesheet"
            href="~/lib/bootstrap/css/bootstrap.min.css"
            asp-append-version="true" />

        <link rel="stylesheet"
            asp-href-include="~/css/site.css"
            asp-append-version="true" />
    </head>
    <body>
        <header>
            <nav class="navbar navbar-expand-lg bg-mercadolibre border-bottom">
                <div class="container">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <span class="logo"></span>
                    </a>

                    <div class="navbar-nav me-auto">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            Inicio
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Usuario") || User.IsInRole("Administrador"))
                            {
                                <a class="nav-link" asp-controller="Comprar" asp-action="Index">
                                    Comprar
                                </a>
                                <a class="nav-link" asp-controller="Carrito" asp-action="Index">
                                    Carrito
                                </a>
                                <a class="nav-link" asp-controller="Pedidos" asp-action="Index">
                                    @(User.IsInRole("Administrador") ? "Pedidos" : "Mis pedidos")
                                </a>
                            }

                            @if (User.IsInRole("Administrador"))
                            {
                                <a class="nav-link" asp-controller="Productos" asp-action="Index">
                                    Productos
                                </a>
                                <a class="nav-link" asp-controller="Categorias" asp-action="Index">
                                    Categorías
                                </a>
                                <a class="nav-link" asp-controller="Usuarios" asp-action="Index">
                                    Usuarios
                                </a>
                                <a class="nav-link" asp-controller="Archivos" asp-action="Index">
                                    Archivos
                                </a>
                                <a class="nav-link" asp-controller="Bitacora" asp-action="Index">
                                    Bitácora
                                </a>
                            }
                        }
                    </div>

                    <div class="navbar-nav ms-auto align-items-center gap-2">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary" data-bs-theme-value="light">Claro</button>
                            <button type="button" class="btn btn-outline-secondary" data-bs-theme-value="dark">Oscuro</button>
                        </div>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="nav-link" asp-controller="Auth" asp-action="Perfil">Mi perfil</a>

                            <a class="nav-link" asp-controller="Auth" asp-action="Seguridad">Seguridad</a>
                            <form asp-controller="Auth"
                                asp-action="Salir"
                                method="post"
                                class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    Cerrar sesión
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="nav-link" asp-controller="Auth" asp-action="Registro">
                                Registrarse
                            </a>
                            <a class="nav-link" asp-controller="Auth" asp-action="Index">
                                Iniciar sesión
                            </a>
                        }
                    </div>
                </div>
            </nav>
        </header>

        <main class="container py-4">
            @RenderBody()
        </main>

        <footer class="border-top py-3 mt-5">
            <div class="container text-muted">
                Ecommerce - ASP.NET Core MVC
            </div>
        </footer>

        <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"
            asp-append-version="true"></script>

        <script asp-src-include="~/js/cambio_tema.js" asp-append-version="true"></script>
        <script asp-src-include="~/js/toggle-password.js" asp-append-version="true"></script>

        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>