@model string
@{
    ViewData["Title"] = "Verificar correo";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-3">Verifica tu correo</h2>
                <form asp-action="VerificarCorreo" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" name="token" value="@Model" />
                    <button class="btn btn-primary w-100" type="submit">Confirmar correo</button>
                </form>
                <a class="d-inline-block mt-3" asp-action="ReenviarVerificacion">Solicitar otro enlace</a>
            </div>
        </div>
    </div>
</div>
