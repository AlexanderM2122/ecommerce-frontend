@model RestablecerCuentaForm
@{
    ViewData["Title"] = "Restablecer contraseña";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-3">Crea una contraseña nueva</h2>
                <form asp-action="RestablecerPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input asp-for="Token" type="hidden" />
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Contraseña nueva</label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password"
                               aria-describedby="requisitos-password" required />
                        <div id="requisitos-password" class="form-text">
                            Usa al menos ocho caracteres, con mayúscula, minúscula, número y símbolo.
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmarPassword" class="form-label">Confirmar contraseña</label>
                        <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" required />
                        <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
                    </div>
                    <button class="btn btn-primary w-100" type="submit">Guardar contraseña</button>
                </form>
                <a class="d-inline-block mt-3" asp-action="RecuperarPassword">Solicitar otro enlace</a>
            </div>
        </div>
    </div>
</div>
