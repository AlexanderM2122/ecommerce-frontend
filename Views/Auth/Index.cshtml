
@model Login

@{
    ViewData["Title"] = "Iniciar sesi�n";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="text-center mb-4">Iniciar sesi�n</h2>

                @if (TempData["AuthMessage"] is string mensaje)
                {
                    <div class="alert alert-success" role="status">@mensaje</div>
                }
                @if (TempData["AuthError"] is string error)
                {
                    <div class="alert alert-danger" role="alert">@error</div>
                }

                <form asp-controller="Auth"
                      asp-action="Index"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email"
                               class="form-label">
                            Correo electr�nico
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               type="email"
                               autocomplete="username"
                               required />

                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password"
                               class="form-label">
                            Contrase�a
                        </label>

                        <input asp-for="Password"
                               class="form-control"
                               type="password"
                               autocomplete="current-password"
                               required />

                        <span asp-validation-for="Password"
                              class="text-danger"></span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Ingresar
                    </button>
                </form>
                <div class="d-flex flex-column gap-2 mt-3">
                    <a asp-action="RecuperarPassword">Olvid� mi contrase�a</a>
                    <a asp-action="ReenviarVerificacion">Solicitar verificaci�n de correo</a>
                </div>
            </div>
        </div>
    </div>
</div>
