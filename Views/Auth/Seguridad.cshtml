@model SeguridadCuentaView
@{
    ViewData["Title"] = "Seguridad de la cuenta";
}
<div class="row justify-content-center mt-4">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-3">Autenticación multifactor</h2>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                @if (Model.Activo)
                {
                    <p class="fw-semibold">Activada</p>
                    @if (Model.Codigos is { Length: > 0 })
                    {
                        <h3 class="h5">Códigos de recuperación</h3>
                        <p>Guárdalos ahora. Se muestran una sola vez y cada código permite iniciar sesión una vez.</p>
                        <ul class="list-unstyled row row-cols-2 g-2 mb-4">
                            @foreach (var codigo in Model.Codigos)
                            {
                                <li class="col"><code>@codigo</code></li>
                            }
                        </ul>
                    }
                    <form asp-action="DesactivarMfa" method="post">
                        <div class="mb-3">
                            <label class="form-label" for="password">Contraseña actual</label>
                            <input class="form-control" type="password" id="password" name="password"
                                   autocomplete="current-password" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="codigo">Código de la app o de recuperación</label>
                            <input class="form-control" id="codigo" name="codigo" autocomplete="one-time-code"
                                   maxlength="16" required />
                        </div>
                        <button class="btn btn-outline-danger" type="submit">Desactivar</button>
                    </form>
                }
                else if (Model.Secreto is { } secreto)
                {
                    <p>En tu app autenticadora, agrega una cuenta basada en tiempo con el nombre Ecommerce e ingresa esta clave.</p>
                    <p class="user-select-all"><code>@secreto</code></p>
                    <form asp-action="ActivarMfa" method="post">
                        <div class="mb-3">
                            <label class="form-label" for="codigo">Código de seis dígitos</label>
                            <input class="form-control" id="codigo" name="codigo" inputmode="numeric"
                                   autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required />
                        </div>
                        <button class="btn btn-primary" type="submit">Activar</button>
                        <a class="btn btn-link" asp-action="Seguridad">Empezar de nuevo</a>
                    </form>
                }
                else
                {
                    <p>Vincula una app autenticadora para confirmar los próximos inicios de sesión.</p>
                    <form asp-action="PrepararMfa" method="post">
                        <div class="mb-3">
                            <label class="form-label" for="password">Contraseña actual</label>
                            <input class="form-control" type="password" id="password" name="password"
                                   autocomplete="current-password" required />
                        </div>
                        <button class="btn btn-primary" type="submit">Vincular app</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
