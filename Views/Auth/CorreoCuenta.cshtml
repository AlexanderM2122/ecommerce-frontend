@model CorreoCuentaForm
@{
    var verificar = ViewData["Verificar"] as bool? == true;
    var accion = verificar ? "ReenviarVerificacion" : "RecuperarPassword";
    ViewData["Title"] = verificar ? "Verificar correo" : "Recuperar contraseña";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-3">@ViewData["Title"]</h2>
                <form asp-action="@accion" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <label asp-for="Email" class="form-label">Correo electrónico</label>
                    <input asp-for="Email" class="form-control" type="email" autocomplete="email" maxlength="254" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                    <button class="btn btn-primary w-100 mt-3" type="submit">Enviar enlace</button>
                </form>
                <a class="d-inline-block mt-3" asp-action="Index">Volver al inicio de sesión</a>
            </div>
        </div>
    </div>
</div>
